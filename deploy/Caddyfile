{
	admin off
	email {$ONE_STATUS_ACME_EMAIL}
}

{$ONE_STATUS_DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	reverse_proxy api:8787 {
		health_uri /health
		health_interval 30s
		health_timeout 5s
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format json
	}
}
