ONE_STATUS_DOMAIN=os.furesta.top
ONE_STATUS_MCP_DOMAIN=mcp.os.furesta.top
ONE_STATUS_ACME_EMAIL=admin@example.com
ONE_STATUS_IMAGE_TAG=production
# Generate these independently once with:
# npx --yes @serenity-kit/opaque@1.1.0 create-server-setup
ONE_STATUS_OPAQUE_SERVER_SETUP=replace-with-the-account-opaque-server-setup
ONE_STATUS_VAULT_OPAQUE_SERVER_SETUP=replace-with-the-wallet-opaque-server-setup
ONE_STATUS_DATA_DIR=/opt/one-status/shared/data
ONE_STATUS_CADDY_DATA_DIR=/opt/one-status/shared/caddy-data
ONE_STATUS_CADDY_CONFIG_DIR=/opt/one-status/shared/caddy-config
ONE_STATUS_POSTGRES_DATA_DIR=/opt/one-status/shared/postgres-data
ONE_STATUS_POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
ONE_STATUS_VAULT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Supported values: self-hosted, tencent-kms
ONE_STATUS_VAULT_KMS_PROVIDER=self-hosted
ONE_STATUS_VAULT_KEK_ID=one-status-production-v1
# The self-hosted KEK is deliberately absent from this file. The deployment
# script creates /opt/one-status/shared/secrets/vault-kek as root:root 0600 and
# provides it to the isolated Vault container as a Compose Secret. It does not
# enter the container environment or the release environment file.
ONE_STATUS_VAULT_KMS_KEY_ID=
ONE_STATUS_VAULT_KMS_REGION=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SESSION_TOKEN=
