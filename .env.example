ONE_STATUS_HOST=127.0.0.1
ONE_STATUS_PORT=8787
ONE_STATUS_DB=.data/one-status.sqlite
# Default shown by graphical onboarding.
ONE_STATUS_DEFAULT_SYNC_URL=https://os.furesta.top
# Enable only when the API is reachable exclusively through a trusted proxy.
ONE_STATUS_TRUST_PROXY=false

# Optional local inventory roots. Use the platform PATH delimiter (: on macOS).
# ONE_STATUS_SCAN_ROOTS=/path/to/project-a:/path/to/project-b
# Structured config parsing is the default. Enable CLI probes only on demand.
ONE_STATUS_INVENTORY_RUN_AGENT_COMMANDS=false
# Optional absolute GitHub CLI path for service environments without shell PATH.
# ONE_STATUS_GH_PATH=/opt/homebrew/bin/gh

# Local client overrides
ONE_STATUS_HOME=.data/device-a

# Supply these only to register or connect a new device.
# ONE_STATUS_PASSWORD=replace-with-a-long-password
# ONE_STATUS_STATUS_KEY=os1_replace-with-your-recovery-key

# MCP explicit credential mode. Set all three together, or leave all three
# unset so MCP reads the local profile.
# ONE_STATUS_URL=http://127.0.0.1:8787
# ONE_STATUS_TOOL_GATEWAY_URL=http://127.0.0.1:8787
# ONE_STATUS_TOKEN=replace-with-device-token
# ONE_STATUS_STATUS_KEY=os1_replace-with-your-recovery-key

# Optional MCP attribution
ONE_STATUS_AGENT_ID=codex
ONE_STATUS_TIMEOUT_MS=10000

# Streamable HTTP MCP
# ONE_STATUS_MCP_BEARER_TOKEN=replace-with-a-separate-long-random-token
ONE_STATUS_MCP_HOST=127.0.0.1
ONE_STATUS_MCP_PORT=3000
# Docker Compose publishes to loopback unless explicitly changed.
ONE_STATUS_MCP_PUBLISH_HOST=127.0.0.1
ONE_STATUS_MCP_ENDPOINT=/mcp
ONE_STATUS_MCP_MAX_SESSIONS=100
ONE_STATUS_MCP_IDLE_TIMEOUT_MS=1800000
